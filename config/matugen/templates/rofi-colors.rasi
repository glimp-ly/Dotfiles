* {
    base:            {{colors.surface.default.hex}};
    mantle:          {{colors.surface_container_low.default.hex}};
    crust:           {{colors.surface_container_lowest.default.hex}};

    surface0:        {{colors.surface_container.default.hex}};
    surface1:        {{colors.surface_container_high.default.hex}};
    surface2:        {{colors.surface_container_highest.default.hex}};

    overlay0:        {{colors.outline.default.hex}};

    subtext0:        {{colors.on_surface_variant.default.hex}};
    text:            {{colors.on_surface.default.hex}};

    accent:          {{colors.primary.default.hex}};
    accent2:         {{colors.tertiary.default.hex}};

    red:             {{colors.error.default.hex}};
    yellow:          {{colors.tertiary.default.hex}};
    green:           {{colors.primary.default.hex}};
    blue:            {{colors.secondary.default.hex}};

    bg-main:         rgba({{colors.surface.default.red}}, {{colors.surface.default.green}}, {{colors.surface.default.blue}}, 0.01);
    bg-alt:          rgba({{colors.surface_container.default.red}}, {{colors.surface_container.default.green}}, {{colors.surface_container.default.blue}}, 0.90);
    bg-selected:     rgba({{colors.primary.default.red}}, {{colors.primary.default.green}}, {{colors.primary.default.blue}}, 0.2);

    fg-main:         {{colors.on_surface.default.hex}};
    fg-dim:          {{colors.on_surface_variant.default.hex}};
    fg-selected:     {{colors.primary.default.hex}};

    border-col:      rgba({{colors.primary.default.red}}, {{colors.primary.default.green}}, {{colors.primary.default.blue}}, 0.80);
    urgent-col:      {{colors.error.default.hex}};
}
