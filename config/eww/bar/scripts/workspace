#!/usr/bin/env bash

# Iconos para los workspaces del 1 al 10
ICONS=("" "" "" "" "" "" "" "" "" "" "")

workspaces() {
    # 1. Obtener workspace activo y workspaces ocupados
    local active_ws occupied_ws
    active_ws=$(hyprctl -j activeworkspace | jq -r '.id')
    occupied_ws=$(hyprctl -j workspaces | jq -r '.[].id')

    # Si por alguna razón active_ws no es numérico, default a 1
    [[ "$active_ws" =~ ^[0-9]+$ ]] || active_ws=1

    # 2. Determinar el rango visible (1..5 o 6..10)
    local start_ws end_ws
    if [ "$active_ws" -le 5 ]; then
        start_ws=1
        end_ws=5
    else
        start_ws=6
        end_ws=10
    fi

    local occ_pattern=" $occupied_ws "
    local buttons=""

    # 3. Iterar únicamente por el rango visible
    for ((i = start_ws; i <= end_ws; i++)); do
        local o="" f=""
        
        # Comprobar si está ocupado
        [[ "$occ_pattern" =~ [[:space:]]"$i"[[:space:]] ]] && o="$i"
        
        # Comprobar si está activo
        [ "$active_ws" -eq "$i" ] && f="$i"

        local class="0${o}${f}"
        local icon="${ICONS[$i]}"

        buttons+=" (button :onclick \"hyprctl dispatch 'hl.dsp.focus({ workspace = \\\"$i\\\" })'\" :class \"$class\" \"$icon\")"
    done

    # 4. Imprimir el bloque Yuck
    echo "(box :class \"works\" :orientation \"v\" :halign \"center\" :valign \"start\" :space-evenly false :spacing -5$buttons)"
}

# Ejecución inicial
workspaces

# Escucha reactiva sobre socket2
SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

if [ -S "$SOCKET" ]; then
    socat -u "UNIX-CONNECT:$SOCKET" - | while read -r line; do
        case "$line" in
            workspace*|focusedmon*|createworkspace*|destroyworkspace*|movewindow*)
                workspaces
                ;;
        esac
    done
else
    while true; do
        sleep 1
        workspaces
    done
fi
