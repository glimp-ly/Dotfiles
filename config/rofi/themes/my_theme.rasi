/**
 * Author: Glimp
 */
/* =============================================================================
 * Integración con colors.rasi (Compatible con Matugen)
 * ============================================================================= */

@import "colors.rasi"

* {
    /* Base y fuentes */
    background-color:            transparent;
    text-color:                  var(fg-main);
    font:                        "JetBrainsMono Nerd Font 10";

    /* Variables legacy mapeadas a colors.rasi */
    foreground:                  var(fg-main);
    background:                  var(bg-main);
    bordercolor:                 var(border-col);
    separatorcolor:              var(surface1);
    spacing:                     2;

    /* Estados normales */
    normal-background:           transparent;
    normal-foreground:           var(fg-dim);
    alternate-normal-background: transparent;
    alternate-normal-foreground: var(fg-dim);

    /* Selección */
    selected-normal-background:  var(bg-selected);
    selected-normal-foreground:  var(fg-selected);

    /* Activo (Conexión establecida / Toggle ON) */
    active-background:           transparent;
    active-foreground:           var(green);
    selected-active-background:  var(bg-selected);
    selected-active-foreground:  var(green);
    alternate-active-background: transparent;
    alternate-active-foreground: var(green);

    /* Urgente / Alertas / Errores */
    urgent-background:           transparent;
    urgent-foreground:           var(urgent-col);
    selected-urgent-background:  var(bg-selected);
    selected-urgent-foreground:  var(urgent-col);
    alternate-urgent-background: transparent;
    alternate-urgent-foreground: var(urgent-col);
}    
window {
    border:     0;
    text-color: #FFFFFFff;
    /*background-color: rgba ( 0, 0, 0, 0 % );*/
    background-color: @blue;
    border: 1px;
    border-color: var(border-col);
    border-radius: 12px;
    padding:    5;
    text-color: @orange;
    background-color: @background;
    transparency: "real";
}
mainbox {
    border:  0;
    padding: 0;
    background-color:               #00000000;
	border:							0% 0% 0% 0%;
    border-radius:                  0% 0% 0% 0%;
	//border-color:					#759cca;
    children:                       [ inputbar, listview ];
    spacing:                       	1%;
    padding:                        1% 1% 1% 1%;
}
message {
    border:     1px dash 0px 0px ;
    text-color: @orange;
    padding:    2px 0px 0px ;
}
textbox {
    text-color: @color;
}

prompt{
    enabled: true;
    background-color: @pywal-color;
    text-color: @black-foreground;
    padding: 	0.25% 0.75% 0.25% 0.75%;
    border-radius: 5%;
    font: "Jet Brains Mono Regular 14";
}

inputbar {
    children:   [ prompt,textbox-prompt-colon,entry,case-indicator ];
    //border-radius: 100px;
}

entry {
	margin: 0.4em 0 0 0;
}

textbox-prompt-colon {
    expand:     false;
    str:        "::";
    margin:     0.4em 0.3em 0em 0em ;
    text-color: @normal-foreground;
    //padding: 1.40% 0% 1% 0%;
}

listview {
    fixed-height: 0;
    border:       2px 0px 0px ;
    padding:      2px 0px 0px ;
    text-color: @orange;
    columns : 2;
    lines:  10;
    spacing: 1%;
    //background-color: @orange;
}
element {
    border: 0;
    background-color: #00000000;
    text-color: #FFFFFFff;
}

element-icon {
    size: 32px;
    text-color: inherit;
}

element-text {
    background-color: #00000000;
    text-color:      inherit;
}

//mode-switcher {
    //border: 1px dash 0px 0px ;
//}
//button selected {
    //text-color: @orange;
    //background-color: #00000000;
//}
element selected {
    background-color:               #00000000;
    text-color:                     @pywal-color;
	border:							0% 0% 0% 0%;
    border-radius:                  4px;
    //border-color:                  	@ac;
}
inputbar {
    spacing: 0;
    border: 0px ;
    text-color: @orange;
}
button normal {
    text-color: @orange;
}
